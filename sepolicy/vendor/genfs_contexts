# Wakeup source directories of the stock S620150 kernel (4.14.190) that the QTI
# msmsteppe policy does not label. Without these lines they keep the label of
# their parent device and system_suspend cannot read them. genfscon matches by
# prefix, so a path ending in "wakeup" also covers the wakeupN directory below it.
genfscon sysfs /devices/platform/soc/888000.i2c/i2c-0/0-0060/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/88e0000.qcom,msm-eud/wakeup u:object_r:sysfs_wakeup:s0
