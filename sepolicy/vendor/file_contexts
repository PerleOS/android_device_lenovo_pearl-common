# Labels of the stock S620150 vendor policy for files the device tree ships as blobs.

/(vendor|system/vendor)/bin/hw/vendor\.dolby\.hardware\.dms@2\.0-service    u:object_r:hal_dms_default_exec:s0
/(vendor|system/vendor)/bin/prop_init                                      u:object_r:prop_init_exec:s0

# AOSP label, for HID braille displays. The legacy-um policy gives these nodes to a VR daemon that
# is not in the build; the longer expression here takes precedence over its /dev/hidraw[0-5].
/dev/hidraw(0|1|2|3|4|5)                                                   u:object_r:hidraw_device:s0

/dev/goodix_fp                                                             u:object_r:fingerprintd_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/fpinfo                      u:object_r:fpinfo_block_device:s0

/mnt/vendor/persist/nv(/.*)?                                               u:object_r:vendor_persist_nv_file:s0
/mnt/vendor/persist/camera(/.*)?                                           u:object_r:vendor_persist_nv_file:s0

/sys/devices/platform/soc/1d84000\.ufshc/size                              u:object_r:sysfs_hwinfo:s0
/sys/hwinfo(/.*)?                                                          u:object_r:sysfs_hwinfo:s0
