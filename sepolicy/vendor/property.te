#
# Lenovo properties of the stock S620150 vendor policy.

vendor_restricted_prop(lenovo_ro_prop)
vendor_restricted_prop(lenovotb_init_prop)

# ro.odm.lenovo.* come from vendor.prop, which init loads as vendor_init.
set_prop(vendor_init, lenovo_ro_prop)

# The stock init shell scripts read ro.odm.lenovo.* with getprop.
get_prop(vendor_qti_init_shell, lenovo_ro_prop)
